{
  "expo": {
    "name": "Best Way to Muscle Utility",
    "slug": "best-way-to-muscle-utility-second",
    "version": "1.0.0",
    "scheme": "bestwaytomuscleutility",
    "orientation": "portrait",
    "sdkVersion": "53.0.0",
    "newArchEnabled": false,
    "icon": "./assets/images/bwmu.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/bwmu.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "requireFullScreen": true,
      "bundleIdentifier": "com.bestwaytomuscleutility-second",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIDeviceFamily": [
          1,
          1
        ],
        "UIRequiredDeviceCapabilities": [
          "telephony",
          "telephony"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bwmu.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.huwmb.bestwaytomuscleutilitysecond"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": ""
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "87963d88-e741-4f6c-b737-2d14812c540a"
      },
      "router": {}
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "huwmb"
  }
}
