{
  "expo": {
    "name": "ElephantBetnch Kit8",
    "slug": "elephant-bench-kit-8",
    "version": "1.0.0",
    "scheme": "elephantbenchkit8",
    "orientation": "portrait",
    "sdkVersion": "53.0.0",
    "newArchEnabled": false,
    "icon": "./assets/images/bench_icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/bench_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "requireFullScreen": true,
      "bundleIdentifier": "com.goytpolkibverda",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIDeviceFamily": [
          1,
          1
        ],
        "UIRequiredDeviceCapabilities": [
          "telephony",
          "telephony"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bench_icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.goytpolkibverda"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/bench_icon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/5f0c5449-dcd8-438e-9d30-a06ba00ad446"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "5f0c5449-dcd8-438e-9d30-a06ba00ad446"
      },
      "router": {}
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "otsmb"
  }
}
